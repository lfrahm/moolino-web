---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Impressum"
  description="Impressum der Moolino Website."
>
  <article class="legal-page shell">
    <p class="page-label">Rechtliches</p>
    <h1>Impressum</h1>
    <div class="placeholder-notice" role="note">
      <strong>Platzhalter</strong>
      <p>
        Die gesetzlich erforderlichen Anbieterangaben werden vor der
        Veröffentlichung ergänzt.
      </p>
    </div>
    <p>
      Diese Seite ist Teil der technischen Website-Grundlage und enthält noch
      keine rechtsverbindlichen Unternehmensangaben.
    </p>
    <a class="text-link" href="/">Zurück zur Startseite</a>
  </article>
</BaseLayout>
