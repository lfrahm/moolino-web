---
import BaseLayout from "../layouts/BaseLayout.astro";

const advantages = [
  {
    title: "Wetterfest gedacht",
    copy: "Das Gehäuse wird für den dauerhaften Einsatz im Garten entwickelt.",
    icon: "weather",
  },
  {
    title: "Smart steuerbar",
    copy: "Betrieb und Einstellungen sollen sich später passend zur Situation anpassen lassen.",
    icon: "signal",
  },
  {
    title: "Ohne Gift",
    copy: "Das geplante Wirkprinzip kommt ohne chemische Wirkstoffe aus.",
    icon: "leaf",
  },
  {
    title: "Ohne Fallen",
    copy: "Moolino ist als Vergrämungslösung gedacht – nicht zum Fangen oder Töten.",
    icon: "open",
  },
];

const faqs = [
  {
    question: "Was ist Moolino?",
    answer:
      "Moolino ist ein Entwicklungsprojekt für ein technisches Gerät zur Maulwurfvergrämung im Garten. Der aktuelle Stand ist ein Entwicklungsprototyp: Gehäuse, Elektronik, Steuerung und die spätere Anwendung werden noch erprobt und weiterentwickelt.",
  },
  {
    question: "Wie soll das Prinzip funktionieren?",
    answer:
      "Moolino soll wiederkehrende Vibrationen und Schallimpulse in den Boden einbringen. Diese mechanischen Impulse breiten sich im Erdreich aus; ihre Wahrnehmung und Wirkung können jedoch je nach Bodenart, Feuchtigkeit, Flächengröße, Umgebung und Anwendung unterschiedlich sein. Die Darstellung auf dieser Seite erklärt das geplante Prinzip, ersetzt aber keine Erprobung am jeweiligen Standort.",
  },
  {
    question: "Ist Moolino bereits erhältlich?",
    answer:
      "Nein. Moolino ist noch nicht im Verkauf und es werden keine Vorbestellungen angenommen. Derzeit werden Prototyp und Pilotserie vorbereitet. Erst aus den Erkenntnissen dieser Entwicklungsphase kann sich ergeben, ob, wann und in welcher Form ein Produkt später verfügbar sein könnte.",
  },
  {
    question: "Kann ich Moolino testen?",
    answer:
      "Interesse an einem späteren Produkttest kann unverbindlich vorgemerkt werden. Ob, wann und unter welchen Voraussetzungen ein Test möglich ist, hängt vom Entwicklungsverlauf, passenden Testumgebungen und der verfügbaren Pilotserie ab. Eine Vormerkung ist weder eine Zusage noch eine Bestellung.",
  },
  {
    question: "Ist die Nutzung tierfreundlich gedacht?",
    answer:
      "Moolino ist als Vergrämungslösung ohne Gift und ohne Fallen vorgesehen. Die konkrete Ausgestaltung, sachgerechte Anwendung und die Bewertung möglicher Auswirkungen auf Tiere und Umgebung sind Teil der laufenden Entwicklung und Erprobung. Bis dahin soll die Anwendung stets zurückhaltend, situationsbezogen und mit Blick auf den Garten als Lebensraum gedacht werden.",
  },
];

const heroImages = {
  active: "/moolino-garden-hero-schematic.webp",
  previous: "/moolino-garden-hero.webp",
};

const illustrationImages = {
  molehills: {
    active: "/moolino-garden-molehills-schematic.webp",
    previous: "/moolino-garden-molehills.webp",
  },
  impulses: {
    active: "/moolino-garden-impulses-surface-v2.webp",
    previous: "/moolino-garden-impulses-schematic.webp",
  },
  contact: {
    active: "/moolino-garden-contact-schematic.webp",
    previous: "/moolino-garden-contact.webp",
  },
};
---

<BaseLayout
  title="Moolino"
  description="Moolino entwickelt ein technisches Gerät zur Maulwurfvergrämung durch Vibrationen und Schallimpulse im Boden – derzeit als Entwicklungsprototyp."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__inner shell">
      <div class="hero__copy">
        <h1 id="hero-title">
          Gartenruhe.<br />
          {" "}Vom Boden aus<br />
          {" "}gedacht.
        </h1>
        <p class="hero__lede">
          Moolino wird als technisches Gerät entwickelt, das über Vibrationen
          und Schallimpulse im Boden dazu beitragen soll, Maulwürfe aus
          sensiblen Gartenbereichen zu vergrämen – ohne Gift und ohne Fallen.
        </p>
        <div class="hero__actions">
          <a class="button" href="#neuigkeiten">
            Neuigkeiten erhalten
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <path d="M5 12h14m-5-5 5 5-5 5"></path>
            </svg>
          </a>
          <a class="text-link text-link--arrow" href="#funktionsweise">
            So funktioniert Moolino
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <path d="M5 12h14m-5-5 5 5-5 5"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- To restore the prior local hero, use heroImages.previous as the image source and remove hero-garden--schematic. -->
      <figure
        class="hero-garden hero-garden--schematic"
        data-previous-hero={heroImages.previous}
      >
        <img
          class="hero-garden__art"
          src={heroImages.active}
          width="1536"
          height="1024"
          alt=""
          fetchpriority="high"
        />
        <div class="hero-garden__prototype">
        <img
          src="/moolino-prototype-front.png"
          width="1496"
          height="1051"
          alt="Grüner Moolino Entwicklungsprototyp mit zylindrischem Gehäuse"
          fetchpriority="high"
        />
        </div>
        <figcaption>
          <strong>Aktueller Entwicklungsprototyp</strong>
          <span>Form, Farbe und Details können sich ändern.</span>
        </figcaption>
      </figure>
    </div>
    <div class="hero__earth-line" aria-hidden="true">
      <svg viewBox="0 0 1440 90" preserveAspectRatio="none">
        <path d="M0 54C170 15 316 81 511 51S843 26 1035 55s282-23 405-3"></path>
        <path d="M0 73c192-27 308 35 487 10s359-18 525 0 296-25 428-15"></path>
      </svg>
    </div>
  </section>

  <section class="problem section" aria-labelledby="problem-title">
    <div class="problem__inner shell">
      <div class="section-heading problem__copy">
        <p class="section-label">Die Ausgangslage</p>
        <h2 id="problem-title">Wenn Hügel die Gartenruhe stören.</h2>
        <p>
          Ein Maulwurf arbeitet fast vollständig unter der Erde. Sichtbar
          werden vor allem seine Erdhügel – mitten im Rasen, zwischen Beeten
          oder an Wegen. Das kann gepflegte Flächen verändern und zusätzliche
          Gartenarbeit verursachen.
        </p>
      </div>

      <figure
        class="garden-illustration garden-illustration--molehills"
        data-previous-illustration={illustrationImages.molehills.previous}
      >
        <img
          src={illustrationImages.molehills.active}
          width="1280"
          height="711"
          alt="Illustration eines Gartens mit mehreren deutlich sichtbaren Maulwurfshügeln im Rasen"
          loading="lazy"
        />
      </figure>
    </div>
  </section>

  <section
    class="solution section"
    id="funktionsweise"
    aria-labelledby="solution-title"
  >
    <div class="solution__inner shell">
      <div class="section-heading">
        <p class="section-label">Der Ansatz</p>
        <h2 id="solution-title">
          Impulse im Boden – gezielt und zurückhaltend.
        </h2>
        <p>
          Wiederkehrende mechanische Impulse breiten sich im Erdreich aus.
          Moolino soll dieses bekannte Prinzip technisch steuerbar machen.
          Welche Einstellungen sinnvoll sind, hängt unter anderem von
          Bodenbeschaffenheit, Fläche und Umgebung ab.
        </p>
        <p class="fine-print">
          Die Darstellung veranschaulicht das technische Prinzip und ist kein
          Wirksamkeitsnachweis.
        </p>
      </div>

      <figure
        class="garden-illustration garden-illustration--impulses"
        data-previous-illustration={illustrationImages.impulses.previous}
      >
        <img
          src={illustrationImages.impulses.active}
          width="1280"
          height="853"
          alt="Schematische Gartenillustration mit einem auf der Rasenoberfläche liegenden Moolino Entwicklungsprototyp und sich im Boden ausbreitenden Impulswellen"
          loading="lazy"
        />
      </figure>
    </div>
  </section>

  <section class="steps section" aria-labelledby="steps-title">
    <div class="shell">
      <div class="steps__intro">
        <p class="section-label">So funktioniert es</p>
        <h2 id="steps-title">Platzieren. Einschalten. Arbeiten lassen.</h2>
      </div>

      <ol class="steps__list">
        <li>
          <span class="steps__number">01</span>
          <div>
            <h3>Platzieren</h3>
            <p>
              Den Prototypen an einem geeigneten Ort im Garten anbringen.
            </p>
          </div>
        </li>
        <li>
          <span class="steps__number">02</span>
          <div>
            <h3>Einschalten</h3>
            <p>
              Das Gerät aktivieren und passend zur Umgebung einstellen.
            </p>
          </div>
        </li>
        <li>
          <span class="steps__number">03</span>
          <div>
            <h3>Arbeiten lassen</h3>
            <p>
              Moolino soll die vorgesehenen Impulse anschließend selbstständig
              abgeben.
            </p>
          </div>
        </li>
        <li>
          <span class="steps__number">04</span>
          <div>
            <h3>App steuern</h3>
            <p>
              Mit der App lassen sich das Gerät steuern und Betriebszeiten
              festlegen.
            </p>
          </div>
        </li>
        <li>
          <span class="steps__number">05</span>
          <div>
            <h3>Flexibel pausieren</h3>
            <p>
              Für ausgewählte Zeiträume lässt sich der Betrieb vorübergehend
              pausieren.
            </p>
          </div>
        </li>
      </ol>

    </div>
  </section>

  <section class="advantages section" aria-labelledby="advantages-title">
    <div class="advantages__inner shell">
      <div class="section-heading advantages__heading">
        <p class="section-label">Die Entwicklungsziele</p>
        <h2 id="advantages-title">Durchdacht für draußen.</h2>
        <p>
          Diese Eigenschaften leiten die Entwicklung. Sie beschreiben den
          angestrebten Produktcharakter und noch keine garantierten Ergebnisse.
        </p>
      </div>

      <ul class="advantages__list">
        {
          advantages.map((advantage) => (
            <li>
              <span class={`line-icon line-icon--${advantage.icon}`} aria-hidden="true">
                {advantage.icon === "weather" && (
                  <svg viewBox="0 0 36 36">
                    <path d="M9 24h18a6 6 0 0 0 1-11.9A10 10 0 0 0 9.3 10 7 7 0 0 0 9 24Z" />
                    <path d="m12 28-1 3m7-3-1 3m7-3-1 3" />
                  </svg>
                )}
                {advantage.icon === "signal" && (
                  <svg viewBox="0 0 36 36">
                    <path d="M6 15a17 17 0 0 1 24 0M10 20a11 11 0 0 1 16 0m-11 5a4 4 0 0 1 6 0" />
                    <circle cx="18" cy="29" r="1.3" />
                  </svg>
                )}
                {advantage.icon === "leaf" && (
                  <svg viewBox="0 0 36 36">
                    <path d="M29 7C16 7 8 13 8 23c0 4 2 6 6 6 10 0 15-9 15-22Z" />
                    <path d="M8 30c4-8 10-12 17-17" />
                  </svg>
                )}
                {advantage.icon === "open" && (
                  <svg viewBox="0 0 36 36">
                    <path d="M7 7h22v22H7zM10 26 26 10" />
                  </svg>
                )}
              </span>
              <div>
                <h3>{advantage.title}</h3>
                <p>{advantage.copy}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section
    class="development section"
    id="entwicklung"
    aria-labelledby="development-title"
  >
    <div class="development__inner shell">
      <div class="development__copy section-heading">
        <p class="section-label">Entwicklungsstand</p>
        <h2 id="development-title">
          Noch im Werden. Schon klar in der Richtung.
        </h2>
        <p>
          Moolino befindet sich in einer frühen Entwicklungsphase. Gehäuse,
          Elektronik und Steuerung werden schrittweise erprobt; parallel wird
          eine kleine Pilotserie vorbereitet.
        </p>
        <p>
          Ergebnisse aus dieser Phase fließen in die weitere Gestaltung und
          technische Ausarbeitung ein. Einen Termin für eine Verfügbarkeit gibt
          es noch nicht.
        </p>
      </div>

      <figure class="prototype prototype--development">
        <div class="prototype__media">
          <img
            src="/moolino-prototype-wide.png"
            width="2120"
            height="742"
            alt="Seitliche Ansicht des grünen Moolino Entwicklungsprototyps"
            loading="lazy"
          />
        </div>
        <figcaption>
          <strong>Aktueller Entwicklungsprototyp</strong>
          <span>Form, Farbe und Details können sich ändern.</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section
    class="newsletter section"
    id="neuigkeiten"
    aria-labelledby="newsletter-title"
  >
    <div class="newsletter__inner shell">
      <div class="newsletter__copy">
        <div class="newsletter__symbol" aria-hidden="true">
          <svg viewBox="0 0 48 48">
            <path d="M8 13h32v23H8z"></path>
            <path d="m9 15 15 12 15-12"></path>
          </svg>
        </div>
        <div class="section-heading">
          <p class="section-label">Projekt-Updates</p>
          <h2 id="newsletter-title">Neuigkeiten erhalten</h2>
          <p>
            Wir melden uns, wenn es etwas Relevantes zur Entwicklung und zu
            möglichen Tests zu teilen gibt. Keine Produktversprechen, keine
            tägliche Post.
          </p>
          <ul class="newsletter__topics" aria-label="Inhalte der Projekt-Updates">
            <li>Entwicklungsstand</li>
            <li>Mögliche Tests</li>
          </ul>
        </div>
      </div>

      <form class="signup-form" data-preview-form>
        <label for="newsletter-email">E-Mail-Adresse</label>
        <div class="signup-form__row">
          <input
            id="newsletter-email"
            name="email"
            type="email"
            autocomplete="email"
            placeholder="name@beispiel.de"
            required
          />
          <button class="button" type="submit">Updates abonnieren</button>
        </div>
        <p class="form-note">
          Der Versand ist in dieser lokalen Vorschau noch nicht aktiv.
        </p>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <section
    class="tester section"
    id="produkttest"
    aria-labelledby="tester-title"
  >
    <div class="tester__inner shell">
      <div class="tester__copy section-heading">
        <p class="section-label">Pilotphase</p>
        <h2 id="tester-title">Als Produkttester bewerben</h2>
        <p>
          Du möchtest einen frühen Prototypen im eigenen Garten erproben und
          strukturiertes Feedback geben? Dann kannst du dein Interesse
          unverbindlich vormerken.
        </p>
        <p class="fine-print">
          Eine Teilnahme ist freiwillig und nicht garantiert. Die Zahl der
          Geräte in der Pilotserie kann begrenzt sein.
        </p>
      </div>

      <form class="tester-form" data-preview-form>
        <div class="field-grid">
          <div>
            <label for="tester-name">Name</label>
            <input
              id="tester-name"
              name="name"
              type="text"
              autocomplete="name"
              required
            />
          </div>
          <div>
            <label for="tester-email">E-Mail-Adresse</label>
            <input
              id="tester-email"
              name="email"
              type="email"
              autocomplete="email"
              required
            />
          </div>
        </div>
        <label for="tester-garden">Kurz zu deinem Garten</label>
        <textarea
          id="tester-garden"
          name="garden"
          rows="3"
          placeholder="Zum Beispiel: Größe, Boden, Häufigkeit der Maulwurfshügel"
        ></textarea>
        <button class="button button--outline" type="submit">
          Interesse vormerken
        </button>
        <p class="form-note">
          Der Versand ist in dieser lokalen Vorschau noch nicht aktiv.
        </p>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <section class="faq section" id="faq" aria-labelledby="faq-title">
    <div class="faq__inner shell">
      <div class="faq__heading">
        <p class="section-label">Wissenswertes</p>
        <h2 id="faq-title">Häufige Fragen</h2>
      </div>

      <div class="faq__list">
        {
          faqs.map((faq, index) => (
            <details open={index === 0}>
              <summary>
                <span>{faq.question}</span>
                <svg aria-hidden="true" viewBox="0 0 24 24">
                  <path d="m6 9 6 6 6-6"></path>
                </svg>
              </summary>
              <p>{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="contact section"
    id="kontakt"
    aria-labelledby="contact-title"
  >
    <div class="contact__inner shell">
      <div class="section-heading">
        <p class="section-label">Kontakt</p>
        <h2 id="contact-title">Fragen oder Interesse?</h2>
        <p>
          Wir freuen uns über Fragen, Anregungen und ehrliches Interesse am
          Projekt.
        </p>
        <a class="contact__mail" href="mailto:team@moolino.de">
          <svg aria-hidden="true" viewBox="0 0 36 36">
            <path d="M5 8h26v20H5z"></path>
            <path d="m6 10 12 10 12-10"></path>
          </svg>
          team@moolino.de
        </a>
      </div>

      <figure
        class="contact__visual"
        data-previous-illustration={illustrationImages.contact.previous}
      >
        <img
          src={illustrationImages.contact.active}
          width="1280"
          height="692"
          alt="Botanische Gartenillustration mit einem dezenten Briefumschlag"
          loading="lazy"
        />
      </figure>
    </div>
  </section>

  <script>
    document.querySelectorAll<HTMLFormElement>("[data-preview-form]").forEach(
      (form) => {
        form.addEventListener("submit", (event) => {
          event.preventDefault();

          if (!form.reportValidity()) return;

          const status = form.querySelector<HTMLElement>(".form-status");
          if (status) {
            status.textContent =
              "Danke für dein Interesse. In dieser lokalen Vorschau werden noch keine Daten übertragen.";
          }
        });
      },
    );
  </script>
</BaseLayout>
